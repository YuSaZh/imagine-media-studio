{
  "schemaVersion": 1,
  "id": "sync-image",
  "name": "Custom Sync Image",
  "operations": ["image.generate"],
  "models": [
    {
      "id": "image-model",
      "displayName": "Image Model",
      "capabilities": {
        "operations": ["image.generate"],
        "supportsBatchCount": false,
        "maxBatchCount": 1
      },
      "requestSchema": {
        "type": "object",
        "properties": {
          "style": { "type": "string", "maxLength": 32 }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "submit": {
    "method": "POST",
    "path": "/v1/images",
    "auth": { "type": "bearer", "secretRef": "apiKey", "location": "header" },
    "body": {
      "type": "json",
      "value": {
        "model": "{{ request.modelId }}",
        "prompt": "{{ request.prompt }}",
        "style": "{{ request.extra.style }}"
      }
    },
    "expectedStatus": [200],
    "extract": {
      "resultBase64Path": "/data/0/b64_json",
      "resultMimeType": "image/png",
      "resultType": "image",
      "resultIdPath": "/data/0/id"
    }
  }
}
