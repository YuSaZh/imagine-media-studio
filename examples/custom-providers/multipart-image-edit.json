{
  "schemaVersion": 1,
  "id": "example-multipart-image-edit",
  "name": "Example Multipart Image Edit",
  "operations": ["image.edit"],
  "inputRules": [
    { "role": "source", "min": 1, "max": 1, "mimeTypes": ["image/png", "image/jpeg"] },
    { "role": "mask", "min": 1, "max": 1, "mimeTypes": ["image/png"] }
  ],
  "models": [
    {
      "id": "edit-model",
      "displayName": "Edit Model",
      "capabilities": {
        "operations": ["image.edit"],
        "supportsMask": true,
        "supportsBatchCount": false,
        "maxBatchCount": 1
      }
    }
  ],
  "submit": {
    "method": "POST",
    "path": "/v1/edits",
    "auth": {
      "type": "bearer",
      "secretRef": "apiKey",
      "location": "header"
    },
    "body": {
      "type": "multipart",
      "fields": {
        "model": "{{ request.modelId }}",
        "prompt": "{{ request.prompt }}"
      },
      "files": [
        {
          "field": "image",
          "input": { "role": "source", "index": 0 },
          "filename": "{{ input.source.0.filename }}"
        },
        {
          "field": "mask",
          "input": { "role": "mask", "index": 0 },
          "filename": "{{ input.mask.0.filename }}"
        }
      ]
    },
    "expectedStatus": [200],
    "extract": {
      "resultUrlPath": "/data/0/url",
      "resultMimeType": "image/png",
      "resultType": "image"
    }
  }
}
