{
  "name": "@imagine/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R migrations dist/migrations",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@imagine/provider-contract": "workspace:*",
    "@imagine/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@imagine/testkit": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.13",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
