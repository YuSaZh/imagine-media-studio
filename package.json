{
  "name": "imagine-media-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A lightweight self-hosted web UI for user-provided media generation APIs.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @imagine/web --filter @imagine/server dev",
    "lint": "eslint .",
    "test": "vitest run && pnpm test:release",
    "test:release": "node .github/scripts/release-workflow.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.13",
    "eslint": "10.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
