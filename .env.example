APP_PORT=3030
DATA_DIR=/data
APP_SECRET=replace-with-at-least-32-random-characters
APP_PASSWORD=
# Optional public application URL for 15-minute provider reference-image links.
PUBLIC_BASE_URL=
MOCK_PROVIDER_ENABLED=true
ALLOW_HTTP_MEDIA_DOWNLOADS=false
ALLOW_INSECURE_PROVIDER_HTTP=false
ALLOW_PRIVATE_NETWORK_ACCESS=false
MAX_IMAGE_UPLOAD_BYTES=33554432
MAX_VIDEO_UPLOAD_BYTES=536870912
MAX_REMOTE_IMAGE_BYTES=67108864
MAX_REMOTE_VIDEO_BYTES=1073741824
PROVIDER_INPUT_MAX_BYTES_PER_FILE=67108864
PROVIDER_INPUT_MAX_TOTAL_BYTES=268435456
MEDIA_PROCESS_TIMEOUT_MS=30000
LOG_LEVEL=info
